# TickShow environment variables
# Copy to .env.local for local browser configuration. Never commit real keys.

# ---------------------------------------------------------------------------
# Browser-only values (VITE_ prefix is public by design)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: used at build time to generate robots.txt and sitemap.xml.
VITE_SITE_URL=https://your-site.vercel.app

# ---------------------------------------------------------------------------
# Edge Function secrets (server-only; NEVER add a VITE_ prefix)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe TEST MODE is enforced by create-checkout-session and stripe-webhook.
# Live keys are rejected by the Edge Functions.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Public origin used for Stripe return URLs, QR links and CORS.
SITE_URL=https://your-site.vercel.app

# Ticket email delivery.
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=tickets@your-verified-domain
BREVO_FROM_NAME=TickShow
