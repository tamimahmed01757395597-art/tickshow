{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase db push",
    "db:migrate:local": "supabase migration up --local",
    "db:types:local": "supabase gen types typescript --local > src/types/database.ts",
    "db:types:remote": "supabase gen types typescript --linked > src/types/database.ts",
    "db:test": "node supabase/tests/run-tests.mjs",
    "db:bundle": "node supabase/build-bootstrap.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "2.1.1",
    "motion": "^14.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
